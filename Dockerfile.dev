# Pinned to the same python:<version>-slim-trixie@sha256:... string as
# Dockerfile, the production image (meta-projects#92). Dependabot's docker
# ecosystem proposes the bump for both files. See README > Deploy.
#
# Intentionally runs as root (unlike Dockerfile, the production image): the
# bind-mounted src/ and tests/ (docker-compose.yml) are owned by the host
# user, and a non-root container user can't write into them (e.g. pytest-cov's
# coverage.xml) unless its UID matches the host's. No real exposure here since
# this container is never reachable outside localhost.
FROM python:3.15.2-slim-trixie@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    POETRY_VERSION=1.8.4 \
    POETRY_HOME=/opt/poetry \
    POETRY_VIRTUALENVS_CREATE=false

RUN pip install --no-cache-dir --upgrade pip==26.3 && \
    pip install --no-cache-dir poetry==$POETRY_VERSION

WORKDIR /app

COPY pyproject.toml poetry.lock* ./
RUN poetry install --no-interaction --no-ansi --no-root

# Headless Chromium for the browser tests (tests/test_landing_layout.py). Dev
# image only: the production Dockerfile neither has pytest-playwright nor a browser.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
# libatomic1: the slim image lacks it and Playwright's bundled node driver needs it.
RUN apt-get update && \
    apt-get install -y --no-install-recommends libatomic1 && \
    playwright install --with-deps chromium && \
    rm -rf /var/lib/apt/lists/*

COPY src/ ./src/

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
